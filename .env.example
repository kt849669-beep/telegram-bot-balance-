# Copy to private/config.env on the VPS, never commit real values.
BOT_TOKEN=
ADMIN_PASSWORD=
PUBLIC_ORIGIN=https://bot.example.com
# Explicit direct IPv4 for all fourteen site APIs. Proxy mode requires SITE_PROXY_URL.
SITE_NETWORK_MODE=direct
# Optional endpoint used only when SITE_NETWORK_MODE=proxy.
SITE_PROXY_URL=
